{
  "name": "belajarena",
  "version": "1.0.0",
  "type": "module",
  "main": "apps/api/server.mjs",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "start": "node apps/api/server.mjs",
    "setup": "npm install && npm --prefix apps/web install && npm --prefix apps/web run build",
    "build": "npm --prefix apps/web run build",
    "build:web": "npm --prefix apps/web run build",
    "dev": "./start-dev.sh",
    "dev:api": "node apps/api/server.mjs",
    "dev:web": "npm --prefix apps/web run dev",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
